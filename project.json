{
  "owner": "anverse",
  "repo": "spike-nix-release",
  "registry": "ghcr.io/anverse/spike-nix-release",
  "tap": "anverse/homebrew-tap",
  "bucket": "anverse/scoop-bucket",
  "latest": "spikectl",
  "components": {
    "spikectl": {
      "kind": "cli",
      "module": "spikectl",
      "paths": [
        "packaging"
      ]
    },
    "spiked": {
      "kind": "service",
      "module": "spiked",
      "paths": [
        "charts/spiked"
      ]
    },
    "spiked-echo": {
      "kind": "service",
      "module": "adapters/echo",
      "paths": [
        "charts/spiked-echo"
      ]
    }
  }
}
